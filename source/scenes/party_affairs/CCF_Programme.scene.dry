@three_point
title: Three Points
subtitle: Our traditional economic direction
on-arrival: three_points += 1


@state_plan
title: State Ownership
subtitle: A rapid expansion of Crown Corporations
on-arrival: ccf_socialism += 3; state_plan += 1

@inducing_enterprise
