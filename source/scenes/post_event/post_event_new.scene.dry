title: Post Event 2
on-arrival: {!

for (c of Q.classes) {
    Q[c + '_lps'] += 0.3 * Q.thatcher_ammunition;
}

if (Q.socred_dying == 1) {
    Q[c + '_scps'] -= 0.5; 
    Q[c + '_lps'] += 0.25; 
    Q[c + '_cps'] += 0.25;
}



