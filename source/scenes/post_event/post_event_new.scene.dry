////////////////////////////////     PARTY STATISTICS

console.log("Updating party membership");

    Q.membership += Q.membership_change;

    Q.membership_change_trend = Q.membership_change > 0
        ? '<img src="img/arrowup.png"> '
        : Q.membership_change < 0
        ? '<img src="img/arrowdown.png"> '
        : '<img src="img/steady.png"> ';

    Q.membership_change_display = Q.membership_change_trend + Q.membership_change;

    Q.membership_change = 0;

!}