title: The Weyburn By-Election
subtitle: Douglas' Seat Up for Grabs
new-page: true
tags: event
view-if: year = 1961 and month = 12
priority: 2
max-visits: 1
on-arrival: {!
    if (!Q.weyburn_campaigning) {Q.weyburn_campaigning = 0;  }
    Q.lps_weyburn_advantage = 4;
!}

= Douglas' Seat up for Grabs

The Weyburn provincial riding results are being held now. It is a two-way race between the CCF(SS) and LPS as Thatcher, seemingly, has convinced the Tories and Socreds not to contest the district. As Douglas' longtime seat, it will be a disappointment if we lose this. 

[? if weyburn_campaigning = 0 : We have done little to no campaigning in Weyburn for this by-election. ?]

[? if weyburn_campaigning >= 1 and weyburn_campaigning < 3 : We have completed some campaigning for Weyburn.  ?]

[? if weyburn_campaigning >= 3 : We have done extensive campaigning in Weyburn ?]

- @weyburn_campaigning: Let's campaign in Weyburn
- @weyburn_results: Let's see the results

@weyburn_campaigning
choose-if: resources >= 1 and weyburn_campaigning < 3
on-arrival: weyburn_campaigning += 1
go-to: weyburn_byelection

@weyburn_results
on-arrival: {!
    Q.weyburn_class = {
        'workers' : 25,
        'farmers' : 45,
        'new_middle' : 12,
        'old_middle' : 12,
        'unemployed' : 6
    };

    Q.lps_weyburn = 0;
    Q.ccf_weyburn = 0;

    for (var c of Q.classes) {
        var lps_class_support = (Q[c + '_lps'] || 0) + Q.lps_weyburn_advantage;
        var ccf_class_support = (Q[c + '_ccf'] || 0) + Q.weyburn_campaigning;

        Q.lps_weyburn += (Q.weyburn_class[c] / 100) * lps_class_support || 0;
        Q.ccf_weyburn += (Q.weyburn_class[c] / 100) * ccf_class_support || 0;
    };

    console.log(Q.lps_weyburn, Q.ccf_weyburn);

    var total_voteshare = Q.lps_weyburn + Q.ccf_weyburn;
    console.log(total_voteshare);

    Q.lps_weyburn = Math.round((Q.lps_weyburn / total_voteshare) * 100);
    Q.ccf_weyburn = Math.round((Q.ccf_weyburn / total_voteshare) * 100);


    var strengths = [Q.lps_weyburn, Q.ccf_weyburn];

    var factionColors = ['#BE0028', '#d29c28'];

    if (window && window.customgeneratemultibar) {
        window.customgeneratemultibar(
            strengths,
            "#333333",
            factionColors,
            "weyburn_results_bar",
            ['Liberals', 'CCF']
        );
    };

!}
go-to: ccf_wins_weyburn if ccf_weyburn > lps_weyburn; lps_wins_weyburn if lps_weyburn > ccf_weyburn

