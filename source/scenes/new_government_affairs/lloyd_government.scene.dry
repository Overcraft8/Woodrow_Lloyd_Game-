title: Government
new-page: true
is-pinned-card: true
view-if: ccf_in_government = 1 and gov_timer <= 0
card-image: img/Saskatchewan_Legislature.jpg
on-arrival: {!
    // document.getElementById('content').style.maxWidth = '';
    // document.getElementById('content').style.width = '40';
    // document.getElementById('mid_panel').style.margin = '';
// 
    //document.getElementById('content').style.maxWidth = '500px';
    //document.getElementById('mid_panel').style.margin = '0 21em';
    Q.month_actions += 1;
    Q.government_tabs = `<div class="tab_container">
    <button class="tab_button" onclick="window.dendryUI.dendryEngine.goToScene('lloyd_government.gov_finance');">Finance</button>
    <button class="tab_button" onclick="window.dendryUI.dendryEngine.goToScene('lloyd_government.gov_economy');">Economy</button>
    <button class="tab_button" onclick="window.dendryUI.dendryEngine.goToScene('lloyd_government.gov_north');">The North</button>
    <button class="tab_button" onclick="window.dendryUI.dendryEngine.goToScene('lloyd_government.gov_agriculture');">Agriculture</button>
    <button class="tab_button" onclick="window.dendryUI.dendryEngine.goToScene('lloyd_government.gov_social');">Social</button>
    <button class="tab_button" onclick="window.dendryUI.dendryEngine.goToScene('lloyd_government.gov_return');">Back</button> 
</div>`;
!}

= Government Options

[+ government_tabs +]

@gov_return
on-arrival: month_actions -= 1
go-to: root


@gov_finance
new-page: true
style: gov-scene

[+ government_tabs +]

Budget: [+ treasury +]

= Taxes

Sales Tax: [+ sales_tax +]%

[? if year >= 1962 : Income Tax Surcharge: [+ income_tax_surcharge +] ?]

[? if year >= 1962 : Corporate Tax: [+ corporate_tax +] ?]

- @sales_tax_increase
- @sales_tax_decrease
- @income_taxation
- @corporate_taxation
- @spending_cuts
- @civil_service_reduction

@sales_tax_increase
title: Sales Tax Increase
subtitle: Levy a 2% increase on the provincial sales tax <br> Currently [+ sales_tax +]%


@sales_tax_decrease
title: Sales Tax Decrease
subtitle: Implement a 2% decrease on the provincial sales tax <br> Currently [+ sales_tax +]%


@income_taxation
title: Income Tax Raise
view-if: year >= 1962
subtitle: The federal government has decentralized the income tax system; Raise a 3% surcharge on top of any existing provincial surcharges to personal income tax payable under the Income Tax Act. 


@corporate_taxation
title: Corporate Tax Raise
view-if: year >= 1962
subtitle: The federal government has decentralized the corporate tax system; Implement a 1% increase on corporate income under the Income Tax Act. 


@spending_cuts
title: Selective Spending Cuts
view-if: year >= 1962
subtitle: Pursue expenditure cuts in select departments through deferred projects, unfilled vacancies, and cutting operating expenses where necessary.


@civil_service_reduction
title: Reduce the Size of the Civil Service
choose-if: treasury <= 0
subtitle: While typically not preferred, by Lloyd, the intense fiscal pressure on government budget leaves this option open. 



@gov_economy
new-page: true
style: gov-scene

[+ government_tabs +]

[
= The Saskatchewan Economy 
