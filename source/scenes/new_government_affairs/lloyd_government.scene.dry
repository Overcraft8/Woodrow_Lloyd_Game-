title: Government
new-page: true
is-pinned-card: true
view-if: ccf_in_government = 1 and gov_timer <= 0
card-image: img/Saskatchewan_Legislature.jpg
on-arrival: {!
    // document.getElementById('content').style.maxWidth = '';
    // document.getElementById('content').style.width = '40';
    // document.getElementById('mid_panel').style.margin = '';
// 
    //document.getElementById('content').style.maxWidth = '500px';
    //document.getElementById('mid_panel').style.margin = '0 21em';
    Q.month_actions += 1;
    Q.government_tabs = `<div class="tab_container">
    <button class="tab_button" onclick="window.dendryUI.dendryEngine.goToScene('lloyd_government.gov_economy');">Economy</button>
    <button class="tab_button" onclick="window.dendryUI.dendryEngine.goToScene('lloyd_government.gov_north');">The Northern Question</button>
    <button class="tab_button" onclick="window.dendryUI.dendryEngine.goToScene('lloyd_government.gov_agriculture');">Agriculture</button>
    <button class="tab_button" onclick="window.dendryUI.dendryEngine.goToScene('lloyd_government.gov_welfare');">Welfare</button>
    <button class="tab_button" onclick="window.dendryUI.dendryEngine.goToScene('lloyd_government.gov_return');">Back</button> 
</div>`;
!}

= Government Options

[+ government_tabs +]

@gov_return
on-arrival: month_actions -= 1
go-to: root



@gov_economy
new-page: true
style: gov-scene

[+ government_tabs +]

[
= The Saskatchewan Economy 
]


[
{!<div class="panel_holder">!}
    {!<div class="panel">Inflation:<br>!}
        [+ inflation_2 +]%
    {!</div>!}
    {!<div class="panel">Unemployment:<br>!}
        [+ unemployed_rounded +]%
        {!<br><img style="width:50%;" src="img/Melfort_Market.jpg">!}
    {!</div>!}
    {!<div class="panel">Rural Poverty Incidence:<br>!}
        [+ rural_poverty +]%
    {!</div>!}
{!</div>!}

{!<div class="panel_holder">!}
    {!<div class="panel">GDP Growth (!}
        [+ economic_year +]
        {!): !}[+ economic_growth_trend +][+ economic_growth_rounded : economic_growth_colorized +]
    {!</div>!}
    {!<div class="panel">Total Saskatchewan Debt: !}
        [+ saskatchewan_debt +]
        {!<div style="text-align:center;"><span style="font-size:8px;">(Indexed to !}
            [+ economic_year +]
        {! GDP)</span></div></div>!}
{!</div>!}
]

- @housing_corp
- @housing_finance
- @attract_industry
- @progressive_taxation
- @cooperative_technical_aid
- @cooperative_tax_aid

@housing_corp
title: A Housing Crown
subtitle: Establish a Crown corporation responsible for constructing and managing affordable housing, particularly for low-income families and elderly residents.

@housing_finance
title: Financing Housing
subtitle: Provide low-interest loans, loan guarantees, and other financial assistance for home construction and renovation 

@attract_industry
title: Incentivizing Industrial Development
subtitle: Attract private industry in secondary sectors by issuing generous grants and loans through the [? if year <= 1962 : Industrial Development Office ?][? if year > 1962 : Saskatchewan Economic Development Corporation ?] [? if year >= 1962 : <br>This will aid in the development of IPSCO and the Saskatchewan Cement Corporation  ?]

@progressive_taxation
title: Implementing Progressive Taxation
view-if: year >= 1962
subtitle: The federal government has decentralized the income tax system; implement a progressive tax reduction, decreasing tax on low- and middle-income earners and raising taxes for corporations and high earners

@cooperative_technical_aid
title: Aiding Cooperatives
subtitle: Provide further technical and operational assistance to developing cooperatives

@cooperative_tax_aid
title: Aiding Cooperatives
subtitle: Provide tax incentives and tax relief to developing cooperatives




