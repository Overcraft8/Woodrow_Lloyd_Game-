style: government-scene
on-arrival: {!
    document.getElementById('content').style.maxWidth = '';
    document.getElementById('mid_panel').style.margin = '';
    document.getElementById('big_panel').style.display = 'flex';

    document.getElementById('content').id = 'content_older';
    document.getElementById('big_panel').style.margin = '';


    //document.getElementById('content').style.maxWidth = '500px';
