title: News
new-page: true
is-special: true

@important_matters

= Matters of Importance

<div class="status-card-row">

  <button id="northern_issue_button" class="status_panel_card">
    <img class="status_panel_card_image" src="img/misc_photos/cree_women.jpg" onclick="window.ChangeTab('big', 'status_big.northern_issue', 'northern_issue_button')"> 
    <span class="card-caption">The Great Northern Question</span> 
  </button>

  <button id="ccf_ndp_button" class="status_panel_card">
    <img class="status_panel_card_image" src="img/CCF/forward_with_ccf.jpg" onclick="window.ChangeTab('big', 'status_big.ccf_or_ndp', 'ccf_ndp_button')"> 
    <span class="card-caption">CCF or NDP?</span> 
  </button>

  <button id="ross_thatcher_button" class="status_panel_card">
    <img class="status_panel_card_image" src="img/portraits/ThatcherRoss.jpg" onclick="window.ChangeTab('big', 'status_big.ccf_or_ndp', 'ross_thatcher_button')"> 
    <span class="card-caption">The Thatcher Problem</span> 
  </button>

  <button id="medicare_button" class="status_panel_card">
    <img class="status_panel_card_image" src="img/protests/anti_medicare_rally_colored.jpg" onclick="window.ChangeTab('big', 'status_big.ccf_or_ndp', 'medicare_button')"> 
    <span class="card-caption">Enacting Medicare</span> 
  </button>


</div>

@news
