title: Next month
set-bg: img/cities/regina_overhead.jpg
is-hand: true
on-arrival: {!
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Special Cards - an action is available.';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = 'Special Cards - next action available in 1 month.';
} else {
    Q.pinnedCardsDescription = 'Special Cards - next action available in ' + Q.advisor_action_timer + ' months.';
}
!}
max-cards: 3
 
