@party
title: Party Affairs
card-image: img/graphics/canada_ccf_call.png
view-if: special_mode == 0
is-deck: true

- #party_affairs

@gov_direction
title: Policy Direction
card-image: img/CCF/ccf_program_sk.png
view-if: special_mode == 0 and programme_timer <= 0
is-deck: true

- #gov_direction

@govt
title: Government Affairs
view-if: time >= 6 and ccf_in_government = 1 and special_mode == 0
card-image: img/Saskatchewan_Legislature.jpg
is-deck: true

- #govt_affairs

@govt_two
title: Government Test 
card-image: img/Saskatchewan_Legislature.jpg
view-if: special_mode == 0
is-deck: true

- #govtwo






